# Copy this file to .env in the backend folder, then edit the connection below.
# Use YOUR actual PostgreSQL role/password and database. Do not commit .env.
# URL-encode password characters such as @, :, # and %.
DATABASE_URL=postgres://YOUR_ROLE:YOUR_PASSWORD@127.0.0.1:5432/diary_db?sslmode=disable

# Optional Google OAuth Desktop app client; see docs/google-setup.md.
# Leave blank to keep using local login/manual backups.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
